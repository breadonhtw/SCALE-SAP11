# Copy to .env and fill in real values. Never commit .env or *credentials*.json
# (both are gitignored). See docs/capability-matrix.md for what is actually
# verified against the team-11 tenant vs. fallback.

APP_ENV=development
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
DEFAULT_REGION=APJ
DISPLAY_TIMEZONE=Asia/Singapore

# local  -> SQLite fallback in ./data/local_trustsphere.db (no creds needed,
#           used for dev/demo when the HANA credentials file is unavailable)
# hana   -> SAP HANA Cloud, team-11 tenant, schema TEAM_11_USER
DATA_BACKEND=local

# Path to team_11_credentials.json (kept outside the repo; see .gitignore).
# Expected shape: {"database": {"host","port","username","password"}, "ai_core": {...}}
TEAM11_CREDS=

# Individual HANA vars are an alternative to TEAM11_CREDS; TEAM11_CREDS wins
# if both are set.
HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=
HANA_ENCRYPT=true
HANA_SCHEMA=TEAM_11_USER
HANA_REFERENCE_SCHEMA=TRUSTSPHERE_REFERENCE

VECTOR_BACKEND=hana
GRAPH_BACKEND=hana
PREDICTION_BACKEND=local_oss
GENERATION_BACKEND=sap_ai_core
WORKFLOW_BACKEND=sap_build

SAP_AI_CORE_CLIENT_ID=
SAP_AI_CORE_CLIENT_SECRET=
SAP_AI_CORE_TOKEN_URL=
SAP_AI_CORE_BASE_URL=
SAP_AI_CORE_RESOURCE_GROUP=team-11
SAP_AI_MODEL_DEPLOYMENT_ID=

SAP_BUILD_API_BASE_URL=
SAP_BUILD_WORKFLOW_DEFINITION_ID=
SAP_BUILD_CLIENT_ID=
SAP_BUILD_CLIENT_SECRET=
SAP_BUILD_TOKEN_URL=

AUDIT_HASHING_KEY=
CASE_DATA_REGION=APJ
ALLOW_SYNTHETIC_DATA_ONLY=false
ENABLE_HISTORICAL_CASE_RETRIEVAL=false

SCORING_POLICY_PATH=config/scoring_policy.yaml
FEATURE_SCHEMA_PATH=config/feature_schema.yaml

# B5 SAP Build Process Automation (Track B)
SBPA_SERVICE_KEY=
SAP_BUILD_API_KEY=
SAP_BUILD_TRIGGER_URL=
